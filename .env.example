# Gothwad Tech — website configuration
# All values are optional; the defaults point at production gothwadtech.com.
# Copy to `.env.local` to override locally. Never commit real secrets here.

# Apex domain used for email addresses and subdomain links
VITE_APP_DOMAIN=gothwadtech.com

# Gothwad Accounts (identity provider + account menu)
VITE_ACCOUNTS_WEB_URL=https://accounts.gothwadtech.com
VITE_ACCOUNTS_API_URL=https://api.gothwadtech.com

# Session fallbacks (apps that expose /api/me with CORS for the apex)
VITE_DRIVE_URL=https://drive.gothwadtech.com
VITE_MAIL_URL=https://mail.gothwadtech.com

# Set to "true" to disable HMR (used by some sandboxed preview environments)
# DISABLE_HMR=false
